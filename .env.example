# Optional settings. Copy to .env to use them; every value has a working default.
# No secrets or API keys are needed: the Elexon API is public and the app reads bundled CSVs.

# Folder containing windfor.csv and fuelhh.csv (default: backend/data).
# DATA_DIR=/app/data

# Host ports used by docker compose (defaults shown). Change them if a port is already in use.
FRONTEND_PORT=8080
BACKEND_PORT=8000
